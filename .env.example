# ==============================================================
# Couple Saving Planner — Contoh Konfigurasi Environment (.env)
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ==============================================================

# 1. Kredensial Google Service Account
# Dapatkan dari Google Cloud Console > IAM & Admin > Service Accounts > Keys (JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 2. Google Spreadsheet ID
# Diambil dari URL Google Sheet: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
# Kosongkan atau biarkan dummy jika ingin menjalankan mode demo lokal (db.json)
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# 3. Autentikasi NextAuth & Password Bersama
# Password tunggal bersama yang digunakan pasangan untuk login ke aplikasi
APP_PASSWORD=password_bersama_kita

# String acak untuk enkripsi sesi JWT NextAuth (misal via `openssl rand -base64 32`)
NEXTAUTH_SECRET=generate-secret-acak-minimal-32-karakter

# URL root aplikasi:
# - Di lokal: http://localhost:3000
# - Di Vercel (Production): https://couple-saver-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
